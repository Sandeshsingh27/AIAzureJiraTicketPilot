# =============================================================
# Shared Jira connectivity
# Used by: orchestrator.py, support_ticket_analyzer.py, web/ui_app.py
# =============================================================
JIRA_URL=https://jira.hrs.io
JIRA_PAT=your_personal_access_token_here

# Used by: Node MCP servers (jira-mcp-server.js, mcp_servers/*)
# Keep same value as JIRA_URL
JIRA_HOST=https://jira.hrs.io

# Optional legacy Jira Cloud basic-auth path
# Used by: ticket_modules/clients/jira_connect.py
JIRA_EMAIL=
JIRA_API_TOKEN=

# =============================================================
# AI chat/classification
# Used by: ticket_modules/chat/chat_agent.py, clients/ai_client.py
# =============================================================
GITHUB_TOKEN=your_github_pat_here
AI_BASE_URL=https://models.inference.ai.azure.com
AI_MODEL=gpt-4o-mini

# =============================================================
# Ticket Orchestrator routing
# Used by: ticket_modules/orchestrator.py
# =============================================================
JIRA_PROJECT_KEY=CRSUP
# Optional exact Jira board display name. If empty, first JIRA_PROJECT_KEY is used for board lookup.
JIRA_BOARD_NAME=CRSUP

IDD_TEAM_USERS=nsh50,team_member2
APAC_ASSIGNEE=ssi51
APAC_WATCHERS=user1,user2
IMN_ASSIGNEE=nsh51

APAC_KEYWORDS=ctrip,autor,vienna
IMN_ROOM_CATEGORY_KEYWORDS=room category
IMN_MISMATCH_KEYWORDS=wrong hotels

# Orchestrator runtime behavior
DRY_RUN=true
TEST_ISSUE_KEY=

# =============================================================
# Support ticket analyzer + New Relic + EC2 singleavail
# Used by: ticket_modules/support_ticket_analyzer.py
# Also used by: mcp_servers/newrelic-log-check-mcp-server.js,
#               mcp_servers/singleavail-ec2-mcp-server.js
# =============================================================
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=4107119
NEW_RELIC_LOG_API_URL=https://log-api.eu.newrelic.com/log/v1
NEW_RELIC_GRAPHQL_URL=https://api.eu.newrelic.com/graphql

# Optional TLS settings for corporate SSL interception/proxy environments
# NEW_RELIC_CA_BUNDLE example: C:\\certs\\corp-root-ca.pem
NEW_RELIC_CA_BUNDLE=
NEW_RELIC_INSECURE=false

EC2_SINGLEAVAIL_URL=http://iut1-crsng-tester-backend.iec.hrs.cc/crsng/singleavail
EC2_BEARER_TOKEN=

# Optional: override ticket analyzer availability keyword file path
TICKET_ANALYSIS_KEYWORDS_FILE=

